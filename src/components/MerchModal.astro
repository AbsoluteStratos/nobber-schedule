---
import { Icon } from 'astro-icon/components';

interface MerchConfig {
  label: string;
  url: string;
}

interface SocialLink {
  label: string;
  url: string;
  icon: string;
}

interface Props {
  merch: MerchConfig;
  socials: SocialLink[];
}

const { merch, socials } = Astro.props;
---

<aside class="floating-tools" aria-label="Event links">
  <a class="floating-tool" href={merch.url} target="_blank" rel="noopener noreferrer" aria-label={merch.label}>
    <Icon name="fa6-solid:shop" aria-hidden="true" />
    <span class="floating-tool-label">{merch.label}</span>
  </a>
  <span class="floating-tools-divider" aria-hidden="true"></span>
  {socials.map((social) => (
    <a class="floating-tool" href={social.url} target="_blank" rel="noopener noreferrer" aria-label={social.label}>
      {social.icon === 'twitch' && (
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 3h16v11l-4 4h-4l-2 2v-2H6V6L4 3Z" />
          <path d="M9 8v5M14 8v5" />
        </svg>
      )}
      {social.icon === 'youtube' && (
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M21 12c0 3.8-.5 5.8-1.3 6.5-.8.7-3.1 1-7.7 1s-6.9-.3-7.7-1C3.5 17.8 3 15.8 3 12s.5-5.8 1.3-6.5c.8-.7 3.1-1 7.7-1s6.9.3 7.7 1c.8.7 1.3 2.7 1.3 6.5Z" />
          <path d="m10 9 5 3-5 3Z" />
        </svg>
      )}
      {social.icon === 'bluesky' && (
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 10.8C10.8 8.5 7.6 4.2 4.7 2.1 2 0 1 1 1 2.9c0 .4.2 3.7.3 4.2.5 1.6 2.1 2.1 3.6 1.9-2.6.4-4.9 1.4-1.9 4.7 3.3 3.4 4.5-.7 4.9-2-.1 2.3.8 5.3 4.1 7.6 3.3-2.3 4.2-5.3 4.1-7.6.4 1.3 1.6 5.4 4.9 2 3-3.3.7-4.3-1.9-4.7 1.5.2 3.1-.3 3.6-1.9.1-.5.3-3.8.3-4.2 0-1.9-1-2.9-3.7-.8-2.9 2.1-6.1 6.4-7.3 8.7Z" />
        </svg>
      )}
      <span class="floating-tool-label">{social.label}</span>
    </a>
  ))}
  <span class="floating-tools-divider" aria-hidden="true"></span>
  <button class="floating-tool theme-toggle" type="button" data-theme-toggle aria-label="Switch color theme">
    <svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="3.5" />
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </svg>
    <svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20 15.2A8.3 8.3 0 0 1 8.8 4 8.4 8.4 0 1 0 20 15.2Z" />
    </svg>
    <span class="floating-tool-label" data-theme-label>Light theme</span>
  </button>
</aside>

<script>
  const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const themeLabel = document.querySelector<HTMLElement>('[data-theme-label]');

  const updateThemeButton = () => {
    const currentTheme = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
    const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
    const label = `${nextTheme[0].toUpperCase()}${nextTheme.slice(1)} theme`;
    if (themeLabel) themeLabel.textContent = label;
    themeButton?.setAttribute('aria-label', `Switch to ${label.toLowerCase()}`);
    document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')?.setAttribute(
      'content',
      currentTheme === 'dark' ? '#160f13' : '#fffaf6',
    );
  };

  themeButton?.addEventListener('click', () => {
    const nextTheme = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = nextTheme;
    try {
      window.localStorage.setItem('schedule-theme', nextTheme);
    } catch {
      // The theme switch remains usable when storage is unavailable.
    }
    updateThemeButton();
  });

  updateThemeButton();
</script>
